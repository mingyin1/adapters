# TavernBench parity configuration. Edit it and push to the parity-ci branch to start a run.
# One KEY=VALUE per line, no spaces in values; text after # is a comment.
# See parity/README.md for the steps and what each run produces.
#
# Order required by the adapter docs: a pilot on both sides, then one full run on both
# sides, then runs 2 and 3 on both sides. Keep MODEL, CLAUDE_CODE_VERSION,
# REASONING_EFFORT and HARBOR_VERSION the same for every run under one LABEL.

ENABLED=false                     # true starts a run when this file is pushed
DRY_RUN=false                     # true: dummy API key, no API budget spent; tests the workflow only
LABEL=pilot                       # results go to runs/<LABEL>/ on the parity-results branch
TASKS=pilot                       # pilot (the 10 tasks in parity/pilot_ids.txt) or all (the 368 eval tasks)
RUNS=1                            # run numbers, comma-separated, e.g. 1 or 2,3
SIDES=both                        # both, harbor or original
SHARDS=1                          # jobs per run and side, each with a share of the tasks (1 for the pilot)

MODEL=                            # exact, dated model id, the same on both sides
MODEL_PROVIDER=anthropic          # Harbor runs -m <MODEL_PROVIDER>/<MODEL>
CLAUDE_CODE_VERSION=2.1.330       # pinned Claude Code version, the same on both sides (used in the dry run)
REASONING_EFFORT=                 # optional: low, medium, high, xhigh or max (both sides)
AUTH_VAR=ANTHROPIC_API_KEY        # name the TB_API_KEY secret gets: ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN
N_CONCURRENT=4                    # tasks run at the same time in each job

HARBOR_VERSION=0.27.0
HARBOR_ENV=docker                 # docker (on the GitHub runner) or daytona (needs the DAYTONA_API_KEY secret)
ADAPTER_REF=tavernbench-adapter   # branch of this repository with the adapter
AUTOTAVERN_REPO=mingyin1/AutoTavern
AUTOTAVERN_REF=harbor-parity      # branch with tavernbench/tavernbench/run_agent.py
